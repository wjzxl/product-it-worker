# 生产环境变量示例（复制为 .env.prod 并填写；不要提交真实密钥）
PLATFORM_DOMAIN=platform.example.com
PUBLIC_BASE_URL=https://platform.example.com
WEBHOOK_SECRET=change-me-strong-secret

# 模型网关
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
LITELLM_MASTER_KEY=sk-litellm-master

# GitLab（内网或 gitlab.com）
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=
OPS_PROJECT_ID=
DEMO_PROJECT=

# 人审认证（SSO）
AUTH_MODE=oidc
OIDC_ISSUER=https://sso.example.com/realms/main
OIDC_AUDIENCE=platform-web
OIDC_REQUIRED_ROLE=approver
AUTH_STATIC_TOKEN=
DEFAULT_TENANT=default

# 执行与沙箱
SANDBOX_MODE=docker
OPS_EXECUTOR=dryrun
OPS_EXECUTOR_URL=

# 工程闸门（WP2/WP3）：off|warn|block
# 建议：先用 warn 跑 2 周真实需求收集样本，再按 scripts/gate_readiness.py 的四项门槛决定是否切 block
ENG_GATES_MODE=warn
# 服务不可用时是否视为未通过（1=是；默认 0=只告警不阻断）
ENG_GATES_REQUIRED=0

# 运行状态持久化（WP7）：memory|postgres
# postgres = 状态落库，进程重启可恢复（等待/唤醒能力依赖它）
CHECKPOINTER=postgres
TRUST_SAMPLE_RATIO=0.2
TRUST_PENALTY_HOURS=24

# ---------------------------------------------------------------------------
# 鉴权专项（2026-09-22）：服务间令牌 —— 上线前必须配置，否则所有写接口对能连上端口的人开放
# 各服务会启动时打 WARNING 明示"当前无服务间鉴权"；置 token 后非豁免路径一律要求 X-Service-Token
SERVICE_AUTH_MODE=token
SERVICE_AUTH_TOKEN=change-me-service-token
# 入口（Caddy/SSO）已登录用户透传的可信头；**必须**在入口剥离客户端自带的同名头
TRUST_PROXY_AUTH=1
# 额外豁免路径（逗号分隔，前缀匹配）。默认豁免 /health,/docs,/openapi.json,/redoc
# 只应豁免"自带签名校验"的入站 webhook（GitLab /webhooks/gitlab、IM /callbacks/im、
# Alertmanager /alerts/prometheus 已在代码里按服务豁免）
SERVICE_AUTH_EXEMPT=

# 告警 webhook 密钥（Alertmanager → task-center /alerts/prometheus）
# 未配置时该入口 fail-closed（503），不再"没配就是全开"
ALERT_WEBHOOK_SECRET=change-me-alert-secret

# 飞书 IM 卡片回调签名密钥（不配则回调一律 503，卡片按钮点不动）
IM_CALLBACK_SIGNING_KEY=
FEISHU_VERIFY_TOKEN=

# 人审决策核验：off|warn|block（SERVICE_AUTH_MODE=token 时默认 block）
# block = 恢复人审挂起必须出示审批台里的真实决策编号，杜绝"自述批准"
GATE_DECISION_VERIFY=block

# 工具调用：请求体里的自述权限默认不采信（受管控部署下）
# 仅在确需外部调用方指定岗位时打开，并确保通道可信
TOOLS_ALLOW_CLIENT_ROLE=0
# 允许请求体自带 allow_ungated（绕过人审依据）——生产务必保持 0
TOOLS_ALLOW_UNGATED=0

# 决策/管理动作的角色白名单（AUTH_MODE=oidc 时生效）
APPROVER_ROLES=approver,admin
